# Optional. Copy to .env.local to override the satellite basemap. Never put secrets in VITE_* variables:
# everything prefixed VITE_ is shipped to the browser. Satellite imagery is the only basemap; do not
# point this at a street map. Keep the provider's required attribution.
# VITE_BASEMAP_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_BASEMAP_ATTRIBUTION=Powered by <a href="https://www.esri.com/">Esri</a> | Imagery: Esri, Vantor, Earthstar Geographics, and the GIS User Community
# Highest zoom level the tile source actually serves (Leaflet upsamples beyond it).
# VITE_BASEMAP_MAX_NATIVE_ZOOM=20
